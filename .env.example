# ── Prava ─────────────────────────────────────────────────────────────────────
# Two integration paths, deliberately kept separate:
#
#  1. REST (this file) — has a SANDBOX. sk_test_ keys from dashboard.prava.space,
#     no real money, card network in test mode. Use this to build and rehearse.
#  2. CLI (@prava-sdk/cli) — LIVE ONLY. No test mode. `prava mandate charge` on
#     the CLI path spends real money on your real card.
#
# Get an sk_test_ key: https://dashboard.prava.space (free, no payment required)
PRAVA_SECRET_KEY=
# Defaults to the sandbox. Only set this to https://api.prava.space when you
# genuinely intend to move real money; the client refuses mismatched key/URL pairs.
PRAVA_BASE_URL=https://sandbox.api.prava.space
# Set to "rest" to use the REST client instead of the offline double.
PRAVA_MODE=
PRAVA_CUSTOMER_ID=metabospend-ops
PRAVA_CUSTOMER_EMAIL=ops@metabospend.local
# Absolute path to the `prava` binary, if it isn't on PATH (CLI path only).
PRAVA_BIN=

# Maps mandate id -> merchant URL. The list endpoint returns only merchantName,
# and a display name is too weak to authorize a payment against, so the URL is
# recorded locally at creation time.
MANDATE_REGISTRY_PATH=.metabospend/mandate-merchants.json

# ── Senso ─────────────────────────────────────────────────────────────────────
# Verified policy ground truth. Without a key, gate 4 refuses every grounded
# agent's spend — which is the correct failure mode, not a bug.
SENSO_API_KEY=
SENSO_BASE_URL=https://api.senso.ai
SENSO_CORPUS=procurement-policy

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
