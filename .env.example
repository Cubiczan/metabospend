# Prava — install the CLI yourself (`npm install -g @prava-sdk/cli`) and link with
# `prava setup`. The CLI holds the keypair locally; this app never sees card data.
PRAVA_BIN=
# Set to 1 to use the real CLI instead of the offline sandbox gateway.
PRAVA_LIVE=

# Senso — verified policy ground truth. Without a key, gate 4 refuses every
# grounded agent's spend, which is the correct failure mode.
SENSO_API_KEY=
SENSO_BASE_URL=https://api.senso.ai
SENSO_CORPUS=procurement-policy

# OpenAI — agent rationales and the natural-language policy query.
OPENAI_API_KEY=
